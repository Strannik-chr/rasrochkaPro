# ==============================================================================
# РассрочкаПро — Конфигурация переменных окружения (.env.example)
# Скопируйте этот файл в .env и заполните реальными секретами перед запуском в production.
# НИКОГДА не коммитьте файл .env в Git-репозиторий!
# ==============================================================================

# 1. Режим окружения и сетевой порт
NODE_ENV="production"
PORT="3000"
APP_URL="https://your-production-domain.example.com"

# 2. Разрешённые источники для CORS (через запятую, без завершающего слэша)
FRONTEND_ORIGIN="https://your-production-domain.example.com"
ALLOWED_ORIGINS="https://your-production-domain.example.com"

# 3. Криптографические секреты (ОБЯЗАТЕЛЬНЫ в production!)
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_32_BYTE_HEX_SECRET_IN_PRODUCTION"
BACKUP_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS_256_BIT_AES_GCM_KEY"

# 4. База данных
# Локальное/контейнерное хранилище SQLite WAL:
SQLITE_STORAGE_PATH="./data/installment_ledger.sqlite"
# Для внешнего облачного PostgreSQL (Supabase / Neon) при использовании миграций из /migrations:
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 5. Режим инициализации базы данных
# Установите "false" в production, чтобы при создании новой БД НЕ добавлялись демонстрационные клиенты и договоры
SEED_DEMO_DATA="false"

# 6. Параметры первичного администратора (используются при чистой инициализации или npm run create-admin)
INITIAL_ADMIN_PHONE="+79285550101"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
INITIAL_ADMIN_NAME="Мо (Владелец)"

# 7. Настройки защиты входа (Brute-force / Lockout / Timeouts)
AUTH_ACCOUNT_MAX_ATTEMPTS="5"
AUTH_ACCOUNT_WINDOW_MS="900000"
AUTH_ACCOUNT_LOCKOUT_MS="900000"
AUTH_IP_MAX_ATTEMPTS="15"
AUTH_IP_WINDOW_MS="900000"
AUTH_IP_LOCKOUT_MS="900000"
AUTH_GLOBAL_MAX_PER_MIN="120"
SESSION_IDLE_TIMEOUT_MS="1800000"
SESSION_MAX_LIFETIME_MS="43200000"

# 8. Приватное файловое хранилище документов (вне публичного web-root)
PRIVATE_STORAGE_DIR="./uploads"
# Опционально: Cloudflare R2 (S3-совместимое приватное хранилище)
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""

# 9. Системная переменная AI Studio (если запускается в облачной среде AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
